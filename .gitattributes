# lightcone-cli — what git-annex stores, and what git carries.
#
# `filter=annex` is what makes an ordinary `git add` route content to the
# annex, so nobody has to run git-annex by hand. `annex.largefiles` then
# decides what counts as content: the default is nothing, and only outputs
# and declared inputs opt out. Last matching line wins.
#
# Manifests are exempted back out because they must be readable on a clone
# that has fetched no annex content.
* annex.largefiles=nothing
* filter=annex
results/** annex.largefiles=anything
data/** annex.largefiles=anything
.datalad/environments/*/image annex.largefiles=anything
results/**/.*.manifest.json annex.largefiles=nothing

# MySTRA reads results/<universe>/<id>/ directly, and the deploy mirror ships
# the tree with `git archive`, which does NOT smudge annex pointers. Anything
# the report resolves must therefore be an inline git blob: annexed, it reaches
# the browser as a 100-byte /annex/objects/... text file and the figure is blank
# or the {astra:value} unresolvable. Only the report-facing directory view is
# exempted here; the flat outputs beside them stay annexed.
results/*/fig_*/** annex.largefiles=nothing
results/*/pte_table_appendix/** annex.largefiles=nothing
results/*/pte_combined_dof_penalized/** annex.largefiles=nothing
results/*/cosebis_harmonic_config/** annex.largefiles=nothing
results/*/cosebis_first_mode_significance/** annex.largefiles=nothing
